{
  "name": "now-board",
  "productName": "Now Board",
  "version": "1.0.0",
  "description": "A calm, local-first focus board for your second monitor.",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "author": "Now Board",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -k -s first \"npm:dev:web\" \"npm:dev:electron\"",
    "dev:web": "vite --port 5173 --strictPort",
    "dev:electron": "wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "build": "npm run typecheck && vite build",
    "start": "electron .",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "screenshots": "node scripts/screenshots.mjs",
    "screenshots:variants": "node scripts/screenshots.mjs --size=1280x800 --variants",
    "icon": "node scripts/make-icon.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "shortcut": "node scripts/create-shortcut.mjs",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build",
    "verify:share": "node scripts/verify-share.mjs",
    "verify:packaged": "node scripts/verify-packaged.mjs"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^45.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.5.0",
    "playwright-core": "^1.64.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^4.1.12",
    "wait-on": "^9.5.1"
  }
}
